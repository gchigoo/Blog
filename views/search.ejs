<%
  const ZH_FALLBACK = {
    'search.title': '搜索',
    'search.heading': '搜索文章',
    'search.keyword': '关键词',
    'search.button': '搜索',
    'search.resultsCount': '“{query}”共有 {count} 条结果。',
    'search.empty': '没有找到相关文章。'
  };
  const translate = typeof i18n === 'function'
    ? i18n
    : (key, variables) => {
        const template = Object.prototype.hasOwnProperty.call(ZH_FALLBACK, key) ? ZH_FALLBACK[key] : key;
        if (!variables) return template;
        return template.replace(/\{([A-Za-z_][A-Za-z0-9_]*)\}/g, (placeholder, name) =>
          Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : placeholder);
      };
%>
<%- include('partials/header', { title: translate('search.title'), user, seo: typeof seo !== 'undefined' ? seo : null }) %>

<h2><%= translate('search.heading') %></h2>
<form class="site-search-form" method="get" action="<%= typeof localizedPath === 'function' ? localizedPath('/search') : '/search' %>" role="search">
  <label for="site-search-query"><%= translate('search.keyword') %></label>
  <div class="site-search-controls">
    <input id="site-search-query" name="q" type="search" maxlength="100" value="<%= query %>" required>
    <button type="submit"><%= translate('search.button') %></button>
  </div>
</form>

<% if (query) { %>
  <p><%= translate('search.resultsCount', { query, count: articles.length }) %></p>
  <% if (articles.length === 0) { %>
    <p class="analytics-empty"><%= translate('search.empty') %></p>
  <% } else { %>
    <ul class="article-list">
      <% articles.forEach(article => { %>
        <li>
          <a href="<%= typeof localizedPath === 'function' ? localizedPath('/article/' + encodeURIComponent(article.slug)) : '/article/' + encodeURIComponent(article.slug) %>"><%= article.title %></a>
          <% if (article.description) { %><p><%= article.description %></p><% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
<% } %>

<%- include('partials/footer') %>
