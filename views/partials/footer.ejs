  </main>
  
  <footer>
    <p><%- typeof i18n === 'function' ? i18n('footer.poweredBy') : 'Powered by Gchigoo <a href="https://github.com/gchigoo/Blog" rel="noopener noreferrer">Minimalist Blog</a>' %> &copy; <%= typeof formatYear === 'function' ? formatYear(new Date()) : new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric' }).formatToParts(new Date()).find(part => part.type === 'year').value %></p>
