<%
  const currentLocale = typeof locale === 'string' ? locale : 'zh';
  const ZH_FALLBACK = {
    'archive.title': '文章归档',
    'archive.empty': '暂无归档内容',
    'archive.year': '{year} 年'
  };
  const translate = typeof i18n === 'function'
    ? i18n
    : (key, variables) => {
        const template = Object.prototype.hasOwnProperty.call(ZH_FALLBACK, key) ? ZH_FALLBACK[key] : key;
        if (!variables) return template;
        return template.replace(/\{([A-Za-z_][A-Za-z0-9_]*)\}/g, (placeholder, name) =>
          Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : placeholder);
      };
  const monthName = monthNumber => new Intl.DateTimeFormat(currentLocale, {
    timeZone: 'Asia/Shanghai',
    month: 'long'
  }).format(new Date(Date.UTC(2000, monthNumber - 1, 15, 12)));
%>
<%- include('partials/header', { title: translate('archive.title'), user }) %>

<h2><%= translate('archive.title') %></h2>

<%
  const years = Object.keys(archive).sort((a, b) => b - a);
%>

<% if (years.length === 0) { %>
  <p class="analytics-empty"><%= translate('archive.empty') %></p>
<% } else { %>
  <% years.forEach(year => { %>
    <div class="archive-year">
      <h3><%= translate('archive.year', { year }) %></h3>
      
      <%
        const months = Object.keys(archive[year]).sort((a, b) => b - a);
      %>
      
      <% months.forEach(month => { %>
        <div class="archive-month">
          <h4><%= monthName(Number(month)) %></h4>
          <ul class="article-list">
            <% archive[year][month].forEach(article => { %>
              <li>
                <a href="<%= typeof localizedPath === 'function' ? localizedPath('/article/' + encodeURIComponent(article.slug)) : '/article/' + encodeURIComponent(article.slug) %>"><%= article.title %></a>
                <span class="article-meta">
                  <%= new Intl.DateTimeFormat(currentLocale, { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric' }).format(new Date(article.created_at)) %>
                </span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  <% }) %>
<% } %>

<%- include('partials/footer') %>
