<%- include('../partials/admin-header', { title: '访问统计' }) %>

<header class="analytics-heading">
  <div>
    <p class="analytics-eyebrow">流量台账</p>
    <h2>访问统计</h2>
    <p class="analytics-heading-copy">先看近况，再核对每次访问。统计按北京时间显示，所选范围为近 <%= overview.days %> 天。</p>
  </div>
  <div class="analytics-heading-actions">
    <nav aria-label="统计时间范围" class="analytics-range-nav">
      <% (typeof rangeOptions === 'undefined' ? [1, 7, 30] : rangeOptions).forEach(days => { %>
        <a href="/admin/analytics?days=<%= days %>" <% if (overview.days === days) { %>aria-current="page"<% } %>>近 <%= days %> 天</a>
      <% }) %>
    </nav>
    <% if (typeof systemStatus !== 'undefined' && systemStatus.warning) { %>
      <a class="analytics-warning-link" href="#analytics-system-status">查看系统告警</a>
    <% } %>
  </div>
</header>

<%
  const trafficLabel = event => event.trafficKind === 'bot'
    ? { className: 'is-bot', text: '爬虫' }
    : event.confirmed ? { className: 'is-human', text: '真人' } : { className: 'is-unconfirmed', text: '未确认' };
  const providerLine = event => event.provider
    ? `AS${event.provider.asn}${event.provider.organization ? ` ${event.provider.organization}` : ''}${event.provider.kind === 'hosting' ? ' · 机房网络' : ''}`
    : null;
  const unconfirmedNetwork = overview.unconfirmedNetwork;
%>
<section id="analytics-overview" class="analytics-overview-grid" aria-labelledby="analytics-overview-title">
  <h3 id="analytics-overview-title" class="analytics-section-title">流量概览</h3>
  <article class="analytics-overview-card">
    <span class="analytics-card-label">今日真人访客</span>
    <strong class="analytics-card-value">
      <% if (!overview.detailsAvailable) { %>
        未启用访问明细
      <% } else { %>
        <%= overview.todayConfirmedVisitors %> 人
      <% } %>
    </strong>
    <span class="analytics-card-note">北京时间今日，页面上有真实操作</span>
  </article>
  <article class="analytics-overview-card">
    <span class="analytics-card-label">真人访问量</span>
    <strong class="analytics-card-value">
      <% if (!overview.detailsAvailable) { %>
        未启用访问明细
      <% } else { %>
        <%= overview.confirmedPageViews %> 次
      <% } %>
    </strong>
    <span class="analytics-card-note">
      <% if (overview.detailsAvailable) { %>
        <%= overview.confirmedVisitors %> 位访客 · <%= overview.confirmedHumanIps %> 个 IP
      <% } else { %>
        确认真人需要访问明细
      <% } %>
    </span>
  </article>
  <article class="analytics-overview-card">
    <span class="analytics-card-label">未确认访问量</span>
    <strong class="analytics-card-value"><%= overview.unconfirmedPageViews %> 次</strong>
    <span class="analytics-card-note">
      像浏览器但没有任何操作，多为脚本<% if (unconfirmedNetwork && unconfirmedNetwork.known > 0) { %>；<%= Math.round(unconfirmedNetwork.hosting * 100 / unconfirmedNetwork.known) %>% 来自机房网络<% } %>
    </span>
  </article>
  <article class="analytics-overview-card analytics-overview-card-bot">
    <span class="analytics-card-label">爬虫访问量</span>
    <strong class="analytics-card-value"><%= overview.botPageViews %> 次</strong>
    <span class="analytics-card-note">已明确识别的自动访问</span>
  </article>
</section>

<section id="event-list" class="analytics-event-workspace" aria-labelledby="analytics-event-summary" aria-busy="false" data-analytics-enhancement="<%= typeof analyticsEnhancementEnabled !== 'undefined' && analyticsEnhancementEnabled ? 'enabled' : 'disabled' %>">
  <% if (events.available === false) { %>
    <div class="analytics-workspace-heading">
      <div>
        <p class="analytics-eyebrow">访问台账</p>
        <h3 id="analytics-event-summary" tabindex="-1">逐次访问明细</h3>
      </div>
    </div>
    <% if (pageError) { %>
      <p id="analytics-event-status" class="message error" role="alert"><%= pageError %></p>
    <% } else { %>
      <p id="analytics-event-status" class="message info" role="status">访问明细未启用；此处不提供已保留或历史逐次访问数据。</p>
    <% } %>
  <% } else { %>
    <div class="analytics-workspace-heading">
      <div>
        <p class="analytics-eyebrow">访问台账</p>
        <h3 id="analytics-event-summary" tabindex="-1">逐次访问明细 · 本页 <%= events.items.length %> 条</h3>
      </div>
      <p>按时间倒序。真人：页面上有真实操作；未确认：像浏览器但没有操作；爬虫：已识别的自动访问。</p>
    </div>

    <form id="analytics-filter-form" class="analytics-filter-form" method="get" action="/admin/analytics#event-list">
      <input type="hidden" name="days" value="<%= filters.days %>">
      <div class="analytics-primary-filters">
        <label class="analytics-search-field" for="analytics-search">搜索 IP、文章标题或路径</label>
        <div class="analytics-search-row">
          <input id="analytics-search" name="search" value="<%= filters.search %>" maxlength="256" placeholder="输入 IP、标题或路径">
          <button type="submit">查询访问</button>
        </div>
      </div>

      <fieldset class="analytics-traffic-filter">
        <legend>访问类型</legend>
        <% [['all', '全部'], ['confirmed', '真人'], ['unconfirmed', '未确认'], ['bot', '爬虫']].forEach(([value, label]) => { %>
          <label>
            <input type="radio" name="traffic" value="<%= value %>" <% if (filters.traffic === value) { %>checked<% } %>>
            <span><%= label %></span>
          </label>
        <% }) %>
      </fieldset>

      <% const analyticsAdvancedNames = ['ip', 'country', 'subdivision', 'city', 'browser', 'os', 'device', 'pathPrefix', 'referrerHost']; %>
      <% const analyticsAdvancedCount = typeof advancedFilterCount === 'number' ? advancedFilterCount : analyticsAdvancedNames.filter(name => filters[name]).length; %>
      <details class="analytics-advanced-filters" <% if (analyticsAdvancedCount > 0) { %>open<% } %>>
        <summary id="analytics-advanced-filter-summary">高级筛选<% if (analyticsAdvancedCount > 0) { %>（<span id="analytics-advanced-filter-count"><%= analyticsAdvancedCount %></span>）<% } %></summary>
        <div class="analytics-filter-grid">
          <label>完整 IP<input name="ip" value="<%= filters.ip %>" placeholder="203.0.113.10"></label>
          <label>国家代码<input name="country" maxlength="2" value="<%= filters.country %>" placeholder="CN"></label>
          <label>一级行政区<input name="subdivision" value="<%= filters.subdivision %>" placeholder="beijing"></label>
          <label>城市<input name="city" value="<%= filters.city %>" placeholder="beijing"></label>
          <label>浏览器<input name="browser" value="<%= filters.browser %>" placeholder="chrome"></label>
          <label>操作系统<input name="os" value="<%= filters.os %>" placeholder="windows"></label>
          <label>设备类别
            <select name="device">
              <option value="">全部</option>
              <% ['desktop', 'mobile', 'tablet', 'other'].forEach(value => { %>
                <option value="<%= value %>" <% if (filters.device === value) { %>selected<% } %>><%= value %></option>
              <% }) %>
            </select>
          </label>
          <label>路径前缀<input name="pathPrefix" value="<%= filters.pathPrefix %>" placeholder="/article/"></label>
          <label>来源域<input name="referrerHost" value="<%= filters.referrerHost %>" placeholder="example.com"></label>
        </div>
      </details>

      <div class="analytics-filter-footer">
        <% const analyticsFallbackLabels = { search: '搜索', traffic: '访问类型', ip: '完整 IP', country: '国家代码', subdivision: '一级行政区', city: '城市', browser: '浏览器', os: '操作系统', device: '设备类别', pathPrefix: '路径前缀', referrerHost: '来源域' }; %>
        <% const analyticsFallbackRemovedNames = removedName => removedName === 'country' ? ['country', 'subdivision', 'city'] : [removedName]; %>
        <% const analyticsFallbackRemoveUrl = removedName => {
          const removedNames = analyticsFallbackRemovedNames(removedName);
          const query = Object.entries(filters)
            .filter(([name, value]) => !removedNames.includes(name) && value)
            .map(([name, value]) => `${encodeURIComponent(name)}=${encodeURIComponent(value)}`);
          return `/admin/analytics?${query.join('&')}#event-list`;
        }; %>
        <% const analyticsFilterItems = typeof appliedFilters !== 'undefined' ? appliedFilters : [
          ...(filters.search ? [{ name: 'search', label: '搜索', value: filters.search, removeUrl: analyticsFallbackRemoveUrl('search') }] : []),
          ...(filters.traffic && filters.traffic !== 'all' ? [{ name: 'traffic', label: '访问类型', value: ({ confirmed: '仅真人', unconfirmed: '仅未确认', human: '仅浏览器类', bot: '仅爬虫' })[filters.traffic] || filters.traffic, removeUrl: analyticsFallbackRemoveUrl('traffic') }] : []),
          ...analyticsAdvancedNames.filter(name => filters[name]).map(name => ({ name, label: analyticsFallbackLabels[name], value: filters[name], removeUrl: analyticsFallbackRemoveUrl(name) }))
        ]; %>
        <div class="analytics-applied-filters" aria-label="已应用筛选">
          <strong>当前条件：</strong>
          <span class="analytics-filter-range">近 <%= filters.days %> 天</span>
          <div class="analytics-filter-chips">
            <% if (analyticsFilterItems.length === 0) { %>
              <span class="analytics-filter-empty">全部访问</span>
            <% } else { %>
              <% analyticsFilterItems.forEach(item => { %>
                <a class="analytics-filter-chip" href="<%= item.removeUrl %>" data-analytics-remove-filter="<%= item.name %>" data-analytics-remove-names="<%= (item.removeNames || analyticsFallbackRemovedNames(item.name)).join(',') %>" aria-label="移除<%= item.label %><%= item.label.endsWith('IP') ? ' ' : '' %>筛选：<%= item.value %>">
                  <span><%= item.label %>：<%= item.value %></span><span aria-hidden="true"> ×</span>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>
        <div class="analytics-filter-actions">
          <button type="submit" class="secondary-button">应用全部筛选</button>
          <a href="/admin/analytics?days=<%= overview.days %>#event-list">清除筛选</a>
        </div>
      </div>
    </form>

    <% if (pageError) { %>
      <p id="analytics-event-status" class="analytics-event-status message error" role="alert" tabindex="-1"><%= pageError %></p>
    <% } else { %>
      <p id="analytics-event-status" class="analytics-event-status" role="status" tabindex="-1" hidden></p>
    <% } %>

    <% if (events.items.length === 0) { %>
      <p class="analytics-empty">暂无符合条件的访问明细。可放宽搜索或筛选条件后重试。</p>
    <% } %>

    <div class="analytics-table-wrap">
      <table class="analytics-event-table">
          <thead>
            <tr><th>时间</th><th>页面</th><th>IP / 地区</th><th>客户端</th><th>操作</th></tr>
          </thead>
          <tbody id="analytics-event-table-body">
            <% events.items.forEach(event => { %>
              <% const eventPage = event.page || { kind: 'other', title: event.displayPath, displayPath: event.displayPath }; %>
              <% const countryName = event.location?.country?.name || '未知'; %>
              <% const subdivisionName = event.location?.subdivision?.name || '未知'; %>
              <% const cityName = event.location?.city || '未知'; %>
              <% const browserName = event.client?.browser?.name || '未知'; %>
              <% const browserVersion = event.client?.browser?.version || ''; %>
              <% const osName = event.client?.os?.name || '未知'; %>
              <% const osVersion = event.client?.os?.version || ''; %>
              <tr data-traffic-kind="<%= event.trafficKind === 'bot' ? 'bot' : 'human' %>">
                <td><time datetime="<%= event.observedAtUtc %>"><%= formatBeijingTime(event.observedAtUtc) %></time></td>
                <td>
                  <div class="analytics-page-cell">
                    <% const label = trafficLabel(event); %>
                    <span class="analytics-traffic-label <%= label.className %>"><%= label.text %></span>
                    <% if (event.trafficKind === 'bot') { %><span class="analytics-bot-name"><%= event.botName %></span><% } %>
                    <strong><%= eventPage.title %></strong>
                    <code class="analytics-break"><%= eventPage.displayPath %></code>
                  </div>
                </td>
                <td>
                  <code class="analytics-break"><%= event.ipAddress %></code>
                  <span class="analytics-secondary-line"><%= countryName %> / <%= subdivisionName %> / <%= cityName %></span>
                  <% if (providerLine(event)) { %><span class="analytics-secondary-line"><%= providerLine(event) %></span><% } %>
                </td>
                <td>
                  <span><%= event.client?.deviceType || '未知' %></span>
                  <span class="analytics-secondary-line"><%= browserName %> <%= browserVersion %> · <%= osName %> <%= osVersion %></span>
                </td>
                <td><button type="button" class="analytics-detail-button" data-event-id="<%= event.id %>">查看详情</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div id="analytics-event-cards" class="analytics-event-cards">
        <% events.items.forEach(event => { %>
          <% const eventPage = event.page || { kind: 'other', title: event.displayPath, displayPath: event.displayPath }; %>
          <% const countryName = event.location?.country?.name || '未知'; %>
          <% const subdivisionName = event.location?.subdivision?.name || '未知'; %>
          <% const cityName = event.location?.city || '未知'; %>
          <% const browserName = event.client?.browser?.name || '未知'; %>
          <% const browserVersion = event.client?.browser?.version || ''; %>
          <% const osName = event.client?.os?.name || '未知'; %>
          <% const osVersion = event.client?.os?.version || ''; %>
          <article class="analytics-event-card" data-traffic-kind="<%= event.trafficKind === 'bot' ? 'bot' : 'human' %>">
            <header class="analytics-event-card-header">
              <div>
                <% const label = trafficLabel(event); %>
                <span class="analytics-traffic-label <%= label.className %>"><%= label.text %></span>
                <% if (event.trafficKind === 'bot') { %><span class="analytics-bot-name"><%= event.botName %></span><% } %>
              </div>
              <time datetime="<%= event.observedAtUtc %>"><%= formatBeijingTime(event.observedAtUtc) %></time>
            </header>
            <div class="analytics-event-card-page">
              <strong><%= eventPage.title %></strong>
              <code class="analytics-break"><%= eventPage.displayPath %></code>
            </div>
            <dl class="analytics-event-card-details">
              <dt>IP / 地区</dt>
              <dd><code class="analytics-break"><%= event.ipAddress %></code><span><%= countryName %> / <%= subdivisionName %> / <%= cityName %></span><% if (providerLine(event)) { %><span><%= providerLine(event) %></span><% } %></dd>
              <dt>客户端</dt>
              <dd><span><%= event.client?.deviceType || '未知' %></span><span><%= browserName %> <%= browserVersion %> · <%= osName %> <%= osVersion %></span></dd>
            </dl>
            <button type="button" class="analytics-detail-button" data-event-id="<%= event.id %>">查看详情</button>
          </article>
        <% }) %>
      </div>

    <nav class="analytics-event-pagination" aria-label="访问明细分页">
      <% if (typeof eventPreviousUrl !== 'undefined' && eventPreviousUrl) { %>
        <a href="<%= eventPreviousUrl %>" data-analytics-page="previous">← 上一页</a>
      <% } else { %>
        <button type="button" data-analytics-page="previous" disabled>← 上一页</button>
      <% } %>
      <% if (eventNextUrl) { %>
        <a href="<%= eventNextUrl %>" data-analytics-page="next">下一页 →</a>
      <% } else { %>
        <button type="button" data-analytics-page="next" disabled>下一页 →</button>
      <% } %>
    </nav>
  <% } %>
</section>

<details id="analytics-more" class="analytics-more">
  <summary>更多分析</summary>
  <div class="analytics-more-content">
    <section aria-labelledby="page-stats-title">
      <h3 id="page-stats-title">页面排行</h3>
      <% if (overview.byPage.length === 0) { %>
        <p>暂无页面统计。</p>
      <% } else { %>
        <div class="analytics-table-wrap">
          <table class="analytics-ranking-table">
            <thead><tr><th>页面</th><th>真人访问量</th><th>真人访客</th><th>未确认</th></tr></thead>
            <tbody>
              <% overview.byPage.forEach(row => { %>
                <tr>
                  <td><code class="analytics-break"><%= row.displayPath %></code></td>
                  <td><%= row.confirmedPageViews %></td>
                  <td><%= row.confirmedVisitors %></td>
                  <td><%= row.pageViews - row.confirmedPageViews %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section aria-labelledby="dimension-title">
      <h3 id="dimension-title">明细维度 <small>最多显示前 50 项</small></h3>
      <div class="analytics-dimension-grid">
        <% [
          ['国家/地区', 'country', overview.byCountry],
          ['一级行政区', 'subdivision', overview.bySubdivision],
          ['城市', 'city', overview.byCity],
          ['浏览器', 'browser', overview.byBrowser],
          ['操作系统', 'os', overview.byOs],
          ['来源域', 'referrerHost', overview.byReferrerHost],
          ['设备型号', null, overview.byDeviceModel]
        ].forEach(([title, filterName, dimension]) => { %>
          <section class="analytics-dimension-card">
            <h4><%= title %></h4>
            <% if (dimension.items.length === 0) { %>
              <p>暂无明细。</p>
            <% } else { %>
              <ul>
                <% dimension.items.forEach(item => { %>
                  <li>
                    <% const filterable = filterName && !item.key.split(':').includes('unknown'); %>
                    <% if (filterable && events.available !== false) { %>
                      <button type="button" class="analytics-filter-shortcut" data-filter-name="<%= filterName %>" data-filter-value="<%= item.key %>"><%= item.label %></button>
                    <% } else { %>
                      <span><%= item.label %></span>
                    <% } %>
                    <strong><%= item.pageViews %></strong>
                  </li>
                <% }) %>
              </ul>
            <% } %>
            <% if (dimension.truncated) { %><p>另有 <%= dimension.otherPageViews %> 次访问未在前 50 项中展示。</p><% } %>
          </section>
        <% }) %>
      </div>
    </section>
  </div>
</details>

<% if (typeof ipBans !== 'undefined' && ipBans) { %>
<section id="ip-bans" class="analytics-ip-bans" aria-labelledby="analytics-ip-bans-title">
  <h3 id="analytics-ip-bans-title">探测封禁</h3>
  <p>请求本站没有的敏感文件或后台路径（如 <code>/.env</code>、<code>/wp-admin</code>、<code>*.php</code>）并得到 4xx 的 IP 会被永久封禁，此后所有请求都返回 403。IPv6 按 /64 封禁。</p>
  <p>共封禁 <strong><%= ipBans.total %></strong> 个地址，近 <%= overview.days %> 天新增 <strong><%= ipBans.recent %></strong> 个；封禁后已拒绝 <strong><%= ipBans.blockedRequests %></strong> 次请求。</p>
  <% if (ipBans.message) { %>
    <p class="message <%= ipBans.message.severity %>" role="<%= ipBans.message.severity === 'error' ? 'alert' : 'status' %>"><%= ipBans.message.text %></p>
  <% } %>
  <% if (ipBans.items.length === 0) { %>
    <p>暂无封禁。</p>
  <% } else { %>
    <div class="analytics-table-wrap">
      <table class="analytics-ranking-table analytics-ban-table">
        <thead><tr><th>地址</th><th>触发请求</th><th>封禁时间</th><th>被拒次数</th><th>操作</th></tr></thead>
        <tbody>
          <% ipBans.items.forEach(ban => { %>
            <tr>
              <td><code class="analytics-break"><%= ban.network %></code><% if (ban.country) { %><span class="analytics-secondary-line"><%= ban.country %></span><% } %></td>
              <td><code class="analytics-break"><%= ban.method %> <%= ban.path %></code><span class="analytics-secondary-line"><%= ban.status %> · <%= ban.userAgent || '无 User-Agent' %></span></td>
              <td data-label="封禁时间"><time datetime="<%= ban.createdAt %>"><%= formatBeijingTime(ban.createdAt) %></time></td>
              <td data-label="被拒次数"><%= ban.hits %></td>
              <td>
                <form method="post" action="/admin/analytics/ip-bans/unban">
                  <input type="hidden" name="network" value="<%= ban.network %>">
                  <input type="hidden" name="days" value="<%= overview.days %>">
                  <button type="submit" class="secondary-button">解除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (ipBans.total > ipBans.items.length) { %><p>只显示最近 <%= ipBans.items.length %> 个；完整列表用 <code>npm run ip-bans</code> 查看。</p><% } %>
  <% } %>
</section>
<% } %>

<section id="analytics-system-status" class="analytics-system-status" aria-labelledby="analytics-system-status-title">
  <h3 id="analytics-system-status-title">系统状态</h3>
  <div class="analytics-system-grid">
    <section>
      <h4>访问明细采集</h4>
      <p><strong><%= systemStatus.detailsEnabled ? '已启用' : '未启用' %></strong></p>
      <% if (systemStatus.detailsEnabled) { %>
        <p>本范围已有 <%= overview.detailCoverage.humanPageViews %> 次浏览器类访问包含明细；<%= overview.detailsComplete ? '覆盖完整。' : '覆盖不完整，较早的访问没有明细。' %></p>
        <p>真人以页面上的真实操作确认（点击、触摸、按键、滚轮或移动指针）；这项信号上线前的访问都计为未确认。</p>
      <% } else { %>
        <p>仅展示真人与爬虫聚合数据，不读取或展示任何逐次访问记录。</p>
      <% } %>
    </section>
    <% if (typeof asnStatus !== 'undefined' && asnStatus) { %>
    <section>
      <h4>网络归属（ASN）</h4>
      <% if (asnStatus.enabled) { %>
        <dl>
          <dt>数据集日期</dt><dd><%= asnStatus.datasetDate || '尚未下载' %></dd>
          <dt>最近检查</dt><dd><%= asnStatus.lastRefresh ? `${asnStatus.lastRefresh.at} / ${asnStatus.lastRefresh.result}` : '暂无' %></dd>
        </dl>
        <p><a href="<%= asnCredit.href %>" rel="noopener noreferrer" target="_blank"><%= asnCredit.label %></a></p>
      <% } else { %>
        <p>未配置 <code>ANALYTICS_ASN_DB_DIR</code>，不识别机房网络。</p>
      <% } %>
    </section>
    <% } %>
    <section>
      <h4>GeoLite2 City</h4>
      <% if (systemStatus.geoData) { %>
        <dl>
          <dt>数据集日期</dt><dd><%= systemStatus.geoData.reader?.datasetDate || '未知' %></dd>
          <dt>应用重载</dt><dd><%= systemStatus.geoData.reader?.reloadStatus || '不可用' %></dd>
          <dt>更新状态</dt><dd><%= systemStatus.geoData.updater?.state || '未知' %> / <%= systemStatus.geoData.updater?.result || 'unknown' %></dd>
          <dt>最近成功</dt><dd><%= systemStatus.geoData.updater?.lastSuccessAt || '暂无' %></dd>
        </dl>
      <% } else { %>
        <p>访问明细未启用，不提供地区数据库状态。</p>
      <% } %>
    </section>
  </div>
  <% if (systemStatus.warning) { %>
    <p class="message <%= systemStatus.warning.severity %>" role="<%= systemStatus.warning.severity === 'error' ? 'alert' : 'status' %>"><%= systemStatus.warning.message %></p>
  <% } %>
</section>

<% if (events.available !== false) { %>
<p id="analytics-detail-status" class="message info" role="status" tabindex="-1" hidden></p>
<section id="analytics-detail-panel" class="analytics-detail-panel" aria-labelledby="analytics-detail-title" tabindex="-1" hidden>
  <h3 id="analytics-detail-title">访问详情</h3>
  <dl>
    <dt>事件 ID</dt><dd id="analytics-detail-id"></dd>
    <dt>时间</dt><dd id="analytics-detail-time"></dd>
    <dt>页面标题</dt><dd id="analytics-detail-page-title"></dd>
    <dt>页面路径</dt><dd id="analytics-detail-page-path"></dd>
    <dt>原始路径</dt><dd id="analytics-detail-raw-path"></dd>
    <dt>访问类型</dt><dd id="analytics-detail-traffic"></dd>
    <dt>爬虫名称</dt><dd id="analytics-detail-bot-name"></dd>
    <dt>来源</dt><dd id="analytics-detail-referrer"></dd>
    <dt>完整 IP</dt><dd id="analytics-detail-ip"></dd>
    <dt>网络归属</dt><dd id="analytics-detail-network"></dd>
    <dt>浏览器</dt><dd id="analytics-detail-browser"></dd>
    <dt>原始 User-Agent</dt><dd id="analytics-detail-user-agent"></dd>
    <dt>客户端解析状态</dt><dd id="analytics-detail-client-status"></dd>
    <dt>浏览器上下文</dt><dd id="analytics-detail-context-status"></dd>
  </dl>
  <details class="analytics-detail-raw">
    <summary>查看完整结构化与原始字段</summary>
    <pre id="analytics-detail-json" class="analytics-detail-json"></pre>
  </details>
</section>
<noscript><p class="message info">启用 JavaScript 后可在本页展开单条完整详情；筛选和分页仍可直接使用。</p></noscript>

<script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/admin-analytics.js') : '/js/admin-analytics.js' %>" defer></script>
<% } %>
<%- include('../partials/admin-footer') %>
