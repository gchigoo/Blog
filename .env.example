# 运行环境：development / production
NODE_ENV=development
# HTTP 监听端口
PORT=3000
# 仅允许环回地址：127.0.0.1 或 ::1
BLOG_LISTEN_HOST=127.0.0.1
# JWT 签名密钥（生产必填，至少 32 字节 UTF-8）
JWT_SECRET=replace-with-at-least-32-byte-secret
# 对外站点 Origin（生产必填，无路径/凭证/查询）
BLOG_PUBLIC_ORIGIN=https://example.com
# 中文站点标题（可回退到 BLOG_TITLE）
BLOG_TITLE_ZH=我的博客
BLOG_TITLE=我的博客
# 中文站点描述（可回退到 BLOG_DESCRIPTION）
BLOG_DESCRIPTION_ZH=技术文章、学习笔记与个人思考
BLOG_DESCRIPTION=技术文章、学习笔记与个人思考
# 英文站点标题
BLOG_TITLE_EN=My Blog
# 英文站点描述
BLOG_DESCRIPTION_EN=Technical articles, study notes, and personal reflections

# 是否启用 Analytics 详情（GeoIP 等）；true / false
ANALYTICS_DETAILS_ENABLED=false
# Analytics HMAC 密钥（canonical unpadded base64url，解码后至少 32 字节）
ANALYTICS_HMAC_SECRET=replace-with-base64url-32-bytes-minimum___________
# 访问指标保留天数（1-365，默认 30）
ANALYTICS_RETENTION_DAYS=30
# 内部 IP 白名单（逗号分隔精确 IP，可留空）
ANALYTICS_INTERNAL_IPS=
# GeoIP City 数据库路径（详情启用时必填）
ANALYTICS_GEOIP_CITY_DB_PATH=/path/to/GeoLite2-City.mmdb
# Analytics 对外 Origin（详情启用时必填）
ANALYTICS_PUBLIC_ORIGIN=https://example.com
# GeoIP 更新状态文件路径（可选，默认与 City DB 同目录）
ANALYTICS_GEOIP_UPDATE_STATUS_PATH=

# Google OAuth 客户端 ID（评论功能四项需同时配置或全部留空）
GOOGLE_CLIENT_ID=
# Google OAuth 客户端密钥
GOOGLE_CLIENT_SECRET=
# Google OAuth 回调 URI（路径必须为 /auth/google/callback）
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
# 评论会话签名密钥（至少 32 字节 UTF-8）
COMMENT_SESSION_SECRET=replace-with-at-least-32-byte-comment-secret
